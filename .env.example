# Banquet database (Aiven MySQL)
DATABASE_URL="mysql://USER:PASS@HOST:PORT/banquet?ssl-mode=REQUIRED"

# Ella PMS database — used for JWT user verification (shared auth)
ELLA_PMS_DATABASE_URL="mysql://USER:PASS@HOST:PORT/ella_pms?ssl-mode=REQUIRED"

# Shared JWT secret — same value as ella_pms and other Synora modules
JWT_SECRET="your-shared-jwt-secret"

# Server port
PORT=4003
