{
  "name": "synora-banquet-back",
  "version": "1.0.0",
  "description": "Synora Banquet Module — Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "node_modules\\.bin\\prisma migrate dev",
    "db:generate": "node_modules\\.bin\\prisma generate",
    "db:studio": "node_modules\\.bin\\prisma studio",
    "db:push": "node_modules\\.bin\\prisma db push",
    "db:seed": "node scripts/seedDummyData.js",
    "migrate:legacy": "node scripts/sprint9/legacyMigration.js",
    "migrate:legacy:dryrun": "node scripts/sprint9/legacyMigration.js --dry-run"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "5.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260901.1": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
